#!/usr/bin/fish
cd (status dirname)

# update packages
uv sync --upgrade
or exit 12

echo
echo "outdated packages:"

# check for outdated
set -l tree (uv tree --outdated --depth 1 --color always -q)
or exit 13

# show outdated and return
echo -e (string join '\n' $tree) | grep latest --color=never
and exit 1
or exit 0
