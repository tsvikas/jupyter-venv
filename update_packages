#!/usr/bin/fish
pushd ~/jupyter-venv

if not git_is_repo
    popd
    exit 1
end

if test -n "$(git status --porcelain)"
    echo "Working directory is not clean. Please commit or discard changes."
    popd
    exit 2
end

uv sync --upgrade
or begin
    popd
    exit 3
end

if test -n "$(git status --porcelain)"
    git commit -a -m "uv upgrade"
end

# echo "\nall outdated packages:"
# uv pip list --outdated

echo "\noutdated packages:"
uv tree --outdated --depth 1 --color always -q | not grep latest --color=never
popd
