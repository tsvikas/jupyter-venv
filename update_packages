#!/usr/bin/env fish
cd (status dirname)

# update packages
# The uv-managed CPython (python-build-standalone) records CC=gcc-13 in its
# sysconfig, so setuptools tries to invoke gcc-13 when building C extensions
# (e.g. multimark, pulled in by great-tables). gcc-13 isn't installed here,
# only gcc, so override CC/CXX to the available compiler.
CC=gcc CXX=g++ uv sync --upgrade
or exit 12

# check for outdated
set -l tree (uv tree --outdated --depth 1 --color always -q)
or exit 13

for line in $tree
  if test -n "$(string match '*latest*' $line)"
    set -a outdated (string split --fields 2 --max 1 ' ' "$line")
  end
end

# show outdated and return
if test -n "$outdated"
  echo
  echo "outdated packages:"
  echo -e (string join '\n' $outdated)
  # exit 1
end
