#!/usr/bin/fish
pushd ~/jupyter-venv

uv sync --upgrade
or begin
    popd
    exit 12
end

echo
echo "outdated packages:"

set -l tree (uv tree --outdated --depth 1 --color always -q)
or begin
    popd
    exit 13
end

echo $tree | grep latest --color=never
and begin
    # found updates
    popd
    exit 1
end

popd
exit 0
